:root{--primary:{{settings.color_primary}};--text:{{settings.color_text}};--bg:{{settings.color_background}};--surface:{{settings.color_surface}};--accent:{{settings.color_accent}};--radius:{{settings.radius}}px}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:{{settings.font_body.family}},sans-serif;font-size:15px;line-height:1.45}h1,h2,h3,h4{font-family:{{settings.font_heading.family}},sans-serif;margin:0 0 8px;line-height:1.08}a{color:inherit;text-decoration:none}button,input,select{font:inherit}.page-width{width:min(1440px,calc(100% - 48px));margin-inline:auto}.skip-link{position:absolute;left:-999px}.skip-link:focus{left:10px;top:10px;background:#fff;padding:10px;z-index:99}
.announcement-bar{background:#101516;color:#fff;font-size:12px}.announcement-inner{height:30px;display:flex;align-items:center;justify-content:space-between}.announcement-left,.announcement-right{display:flex;gap:24px;align-items:center}.announcement-right a{opacity:.95}
.site-header{background:#fff;border-bottom:1px solid #e9ebee}.header-main{min-height:76px;display:grid;grid-template-columns:210px 1fr 180px;gap:28px;align-items:center}.brand{font-family:Arial,sans-serif;font-weight:800;font-size:28px;letter-spacing:-1.8px;display:inline-flex;align-items:end;position:relative}.brand-the{font-size:16px;position:absolute;top:-2px;left:2px}.brand-happy{margin-top:9px}.brand-store{margin-left:5px}.brand-logo{max-height:54px;width:auto;object-fit:contain}.search-box{display:flex;background:#f2f3f5;border-radius:30px;overflow:hidden;height:44px}.search-box input{border:0;background:transparent;outline:0;flex:1;padding:0 20px}.search-box button{width:52px;border:0;background:var(--primary);font-size:25px;cursor:pointer}.header-actions{display:flex;justify-content:flex-end;gap:22px}.header-action{display:flex;flex-direction:column;align-items:center;font-size:12px;position:relative}.header-action .icon{font-size:23px;line-height:22px}.cart-link b{position:absolute;top:-6px;right:-7px;background:#ef3e23;color:#fff;border-radius:20px;font-size:10px;padding:2px 5px}.nav-row{display:flex;align-items:center;gap:30px;min-height:50px}.category-trigger{border:0;background:#f2f3f5;border-radius:10px;padding:9px 14px;font-weight:700;cursor:pointer}.main-nav{display:flex;gap:38px;align-items:center;flex:1}.nav-item{position:relative;padding:16px 0}.nav-dropdown{position:absolute;top:100%;left:-12px;background:#fff;box-shadow:0 15px 35px #0001;border-radius:10px;min-width:190px;padding:8px;display:none;z-index:30}.nav-item:hover .nav-dropdown{display:grid}.nav-dropdown a{padding:10px}.nav-dropdown a:hover{background:#f5f5f5;border-radius:7px}
.section-space{padding:22px 0}.hero-slider{position:relative;overflow:hidden;border-radius:var(--radius);background:#f6e5d4}.hero-slide{display:none;position:relative;min-height:360px}.hero-slide.is-active{display:block}.hero-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.hero-overlay{position:relative;z-index:2;width:var(--hero-width);min-height:360px;padding:55px 70px;display:flex;flex-direction:column;align-items:flex-start;justify-content:center}.hero-overlay h1{font-size:clamp(40px,4.8vw,74px);letter-spacing:-3px}.hero-overlay p{font-size:18px;margin:8px 0 22px}.btn{border:0;border-radius:12px;padding:14px 24px;font-weight:800;cursor:pointer;display:inline-flex;justify-content:center;align-items:center;gap:8px}.btn-dark{background:#0c0c0c;color:#fff}.btn-primary{background:var(--primary);color:#111}.btn-outline{border:1.5px solid var(--accent);background:#fff}.slider-arrow{position:absolute;top:50%;transform:translateY(-50%);border:0;background:#fff;border-radius:50%;width:40px;height:40px;font-size:30px;cursor:pointer;z-index:4}.slider-arrow.prev{left:14px}.slider-arrow.next{right:14px}.slider-dots{position:absolute;bottom:15px;left:50%;transform:translateX(-50%);display:flex;gap:7px;z-index:4}.slider-dots button{width:8px;height:8px;border:0;border-radius:50%;background:#fff8}.slider-dots button.active{background:#fff;width:20px;border-radius:20px}
.category-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.category-card{height:170px;background:var(--card-bg);border-radius:var(--radius);overflow:hidden;position:relative}.category-card img{width:100%;height:100%;object-fit:cover}.category-copy{position:absolute;inset:0;padding:28px;display:flex;flex-direction:column;align-items:flex-start;justify-content:center}.category-copy h3{font-size:25px}.category-copy p{margin:0 0 15px}.category-copy span{background:#fff;border-radius:25px;padding:9px 16px;font-weight:700}
.benefits{background:#f7f8fa}.benefits-grid{display:grid;grid-template-columns:repeat(5,1fr);padding:15px 0;gap:14px}.benefit{display:flex;align-items:center;gap:12px}.benefit-icon{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;background:#e2f6ee;font-size:20px}.benefit small,.trust-row small{display:block;color:#6b7077}.section-heading{display:flex;align-items:end;justify-content:space-between;margin-bottom:16px}.section-heading h2{font-size:28px}.section-heading p{margin:0;color:#777}.section-heading>a{font-weight:700}
.product-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:16px}.product-card{min-width:0}.product-media{display:block;background:#f5f6f8;border-radius:12px;overflow:hidden;aspect-ratio:1/1;position:relative}.product-media img{width:100%;height:100%;object-fit:cover;transition:transform .25s}.product-card:hover .product-media img{transform:scale(1.03)}.discount{position:absolute;left:8px;top:8px;background:#ff3b20;color:#fff;border-radius:6px;padding:4px 7px;font-size:11px;font-weight:800;z-index:2}.wishlist{position:absolute;right:8px;top:8px;border:0;background:#fff;border-radius:50%;width:30px;height:30px;cursor:pointer;z-index:2}.product-info{padding:9px 3px}.product-info h3{font-size:14px;min-height:31px}.rating{color:#ffb000;font-size:13px}.rating span{color:#777}.price{display:flex;gap:8px;align-items:center;margin:4px 0}.price strong{font-size:17px}.price s{color:#888;font-size:13px}.quick-add{width:100%;border:1px solid #ddd;background:#fff;border-radius:8px;padding:7px;cursor:pointer}.sold-out{color:#b00;font-size:13px}
.promo-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.promo-card{height:170px;border-radius:var(--radius);overflow:hidden;position:relative;background:#f4dfce}.promo-card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.promo-card>div{position:relative;z-index:2;padding:30px;width:65%}.promo-card h3{font-size:25px}.promo-card p{margin:5px 0 16px}
.newsletter{padding:25px 0}.newsletter-inner{background:#fff0e6;border-radius:var(--radius);padding:30px 45px;display:flex;justify-content:center;align-items:center;gap:60px;text-align:center}.newsletter-inner h2{font-size:27px}.newsletter-inner p{margin:0}.newsletter-form{display:flex;min-width:430px}.newsletter-form input{flex:1;border:0;padding:14px 16px;border-radius:9px 0 0 9px}.newsletter-form button{border:0;background:#111;color:#fff;border-radius:0 9px 9px 0;padding:0 25px;font-weight:800}
.site-footer{border-top:1px solid #e6e7e9;padding:45px 0 20px}.footer-grid{display:grid;grid-template-columns:2fr repeat(4,1fr);gap:40px}.footer-grid h4{font-size:15px}.footer-grid>div>a{display:block;color:#555;margin:8px 0;font-size:14px}.footer-brand-logo{margin-bottom:15px}.footer-brand p{margin:4px 0;color:#666}.socials{display:grid;gap:7px}.footer-bottom{border-top:1px solid #eee;margin-top:35px;padding-top:18px;display:flex;justify-content:space-between;color:#777;font-size:12px}
.breadcrumbs{font-size:13px;color:#72767c;padding:18px 0}.product-layout{display:grid;grid-template-columns:58% 42%;gap:30px}.product-gallery{display:grid;grid-template-columns:70px 1fr;gap:15px}.thumbs{display:grid;align-content:start;gap:10px}.thumbs button{border:1px solid #ddd;background:#f6f6f6;border-radius:10px;padding:0;overflow:hidden;cursor:pointer}.thumbs img{width:100%;display:block;aspect-ratio:1;object-fit:cover}.main-product-image{background:#f3e3d3;border-radius:var(--radius);overflow:hidden;aspect-ratio:1.05}.main-product-image img{width:100%;height:100%;object-fit:cover}.product-details{padding:10px 15px}.vendor{color:#777;margin:0 0 4px}.product-details h1{font-size:40px;letter-spacing:-1.5px}.rating.large{font-size:16px;margin:10px 0}.rating.large span{font-size:13px}.lead{font-size:16px;color:#51555a}.product-price .price strong{font-size:32px}.product-price{margin:15px 0}.variant-options fieldset{border:0;padding:0;margin:15px 0}.option-values{display:flex;gap:8px;flex-wrap:wrap}.option-values input{display:none}.option-values span{display:block;border:1px solid #ddd;border-radius:9px;padding:9px 14px;cursor:pointer}.option-values input:checked+span{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent)}.quantity-row{display:flex;align-items:center;gap:0;margin:18px 0}.quantity-row label{margin-right:15px}.quantity-row button{width:38px;height:38px;border:1px solid #ddd;background:#fff;cursor:pointer}.quantity-row input{width:50px;height:38px;text-align:center;border:1px solid #ddd;border-inline:0}.product-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px}.trust-row{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:18px 0}.trust-row>div{display:flex;gap:8px;background:#f6f8f9;padding:11px;border-radius:10px}.delivery-box{background:#f1f7ff;padding:15px;border-radius:12px}.product-tabs{margin-top:28px;border:1px solid #e5e7e9;border-radius:14px;overflow:hidden}.tab-head{display:flex;overflow:auto;border-bottom:1px solid #e5e7e9}.tab-head button{border:0;background:#fff;padding:16px 22px;cursor:pointer;white-space:nowrap}.tab-head button.active{font-weight:800;border-bottom:3px solid var(--primary)}.tab-panel{display:none;padding:25px}.tab-panel.active{display:block}.rte img{max-width:100%;height:auto}
.collection-header{display:flex;justify-content:space-between;align-items:end;border-bottom:1px solid #eee;padding-bottom:18px;margin-bottom:20px}.collection-header p{color:#666}.sort-form select{padding:9px;border:1px solid #ddd;border-radius:8px}.collection-layout{display:grid;grid-template-columns:210px 1fr;gap:25px}.filters{background:#f7f8f9;border-radius:12px;padding:18px;height:max-content}.tag-list{display:grid;gap:8px}.tag-list a{background:#fff;padding:7px;border-radius:6px}.collection-layout .product-grid{grid-template-columns:repeat(4,1fr)}
.cart-page{padding:35px 0}.cart-list{display:grid;gap:10px}.cart-item{display:grid;grid-template-columns:110px 1fr auto;gap:18px;align-items:center;border-bottom:1px solid #eee;padding:15px 0}.cart-item img{width:110px;height:110px;object-fit:cover;border-radius:10px}.cart-summary{margin:25px 0 0 auto;max-width:380px;background:#f6f7f8;border-radius:12px;padding:22px}.cart-summary strong{font-size:24px}.empty-state{text-align:center;padding:100px 0}.standard-page,.search-page{padding-bottom:60px}.standard-page h1,.search-page h1{font-size:42px}.search-large{display:flex;max-width:700px;margin:20px 0}.search-large input{flex:1;border:1px solid #ddd;padding:14px;border-radius:9px 0 0 9px}.search-large button{border:0;background:#111;color:#fff;padding:0 25px;border-radius:0 9px 9px 0}.auth-page{max-width:520px;padding:60px 0}.auth-page form{display:grid;gap:12px}.auth-page input{padding:13px;border:1px solid #ddd;border-radius:8px}
.toast{position:fixed;right:20px;bottom:20px;background:#111;color:#fff;padding:12px 16px;border-radius:9px;transform:translateY(120px);opacity:0;transition:.25s;z-index:100}.toast.show{transform:none;opacity:1}.pagination{display:flex;gap:8px;justify-content:center;grid-column:1/-1;padding:20px}.pagination a,.pagination span{padding:8px 12px;border:1px solid #ddd;border-radius:7px}
@media(max-width:1100px){.product-grid{grid-template-columns:repeat(4,1fr)}.header-main{grid-template-columns:180px 1fr 130px}.main-nav{gap:18px}.benefits-grid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:800px){.page-width{width:min(100% - 24px,680px)}.announcement-right{display:none}.header-main{grid-template-columns:1fr auto;gap:12px}.search-box{grid-column:1/-1;grid-row:2}.site-header .header-main{padding:12px 0}.nav-row{overflow:auto}.main-nav{display:none}.category-trigger{white-space:nowrap}.hero-overlay{width:75%;padding:30px}.hero-overlay h1{font-size:40px}.category-grid,.promo-grid{grid-template-columns:1fr}.benefits-grid{grid-template-columns:1fr 1fr}.product-grid,.collection-layout .product-grid{grid-template-columns:repeat(2,1fr)}.product-layout{grid-template-columns:1fr}.product-details h1{font-size:30px}.product-gallery{grid-template-columns:58px 1fr}.newsletter-inner{display:grid;gap:15px;padding:25px}.newsletter-form{min-width:0;width:100%}.footer-grid{grid-template-columns:1fr 1fr}.footer-brand{grid-column:1/-1}.collection-layout{grid-template-columns:1fr}.filters{display:none}}
@media(max-width:480px){.header-actions{gap:10px}.header-action span:not(.icon){display:none}.benefits-grid{grid-template-columns:1fr}.product-grid,.collection-layout .product-grid{gap:10px}.product-actions{grid-template-columns:1fr}.trust-row{grid-template-columns:1fr}.hero-slide{min-height:300px}.hero-overlay{min-height:300px;width:90%;padding:25px}.hero-overlay h1{font-size:33px}.footer-grid{grid-template-columns:1fr}.footer-bottom{display:grid;gap:8px}}

.site-header.is-sticky{position:sticky;top:0;z-index:40}
