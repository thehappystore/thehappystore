[
  {
    "name": "theme_info",
    "theme_name": "The Happy Store",
    "theme_author": "Custom Theme",
    "theme_version": "1.0.0",
    "theme_documentation_url": "https://shopify.dev/docs/storefronts/themes",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "Branding",
    "settings": [
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary color",
        "default": "#ffb400"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#111111"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface",
        "default": "#f5f6f8"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "default": "#ff4b16"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "assistant_n4"
      },
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading font",
        "default": "assistant_n7"
      },
      {
        "type": "range",
        "id": "radius",
        "label": "Corner radius",
        "min": 0,
        "max": 32,
        "step": 2,
        "unit": "px",
        "default": 14
      }
    ]
  },
  {
    "name": "Cart & UX",
    "settings": [
      {
        "type": "checkbox",
        "id": "ajax_cart",
        "label": "Use AJAX cart",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_quick_add",
        "label": "Show quick add",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "sticky_header",
        "label": "Sticky header",
        "default": false
      }
    ]
  }
]