<div class="announcement-bar">
  <div class="page-width announcement-inner">
    <div class="announcement-left">
      {% if section.settings.show_shipping %}<span>🚚 {{ section.settings.shipping_text }}</span>{% endif %}
      {% if section.settings.show_discount %}<span>🎁 {{ section.settings.discount_text }}</span>{% endif %}
      {% if section.settings.show_secure %}<span>🛡 {{ section.settings.secure_text }}</span>{% endif %}
    </div>
    <div class="announcement-right">
      {% if section.settings.track_link != blank %}<a href="{{ section.settings.track_link }}">Track Order</a>{% endif %}
      {% if section.settings.help_link != blank %}<a href="{{ section.settings.help_link }}">Help Center</a>{% endif %}
      <span>{{ localization.country.name }} ({{ localization.country.currency.iso_code }})</span>
    </div>
  </div>
</div>
{% schema %}
{"name":"Announcement bar","settings":[
{"type":"checkbox","id":"show_shipping","label":"Show shipping message","default":true},
{"type":"text","id":"shipping_text","label":"Shipping text","default":"Free Shipping on Orders Above ₹499"},
{"type":"checkbox","id":"show_discount","label":"Show discount message","default":true},
{"type":"text","id":"discount_text","label":"Discount text","default":"Special Discounts Every Week"},
{"type":"checkbox","id":"show_secure","label":"Show secure message","default":true},
{"type":"text","id":"secure_text","label":"Secure text","default":"100% Secure Payments"},
{"type":"url","id":"track_link","label":"Track order link"},
{"type":"url","id":"help_link","label":"Help center link"}
]}
{% endschema %}