<section class="benefits"><div class="page-width benefits-grid">{% for block in section.blocks %}<div class="benefit" {{ block.shopify_attributes }}><span class="benefit-icon">{{ block.settings.icon }}</span><div><strong>{{ block.settings.title }}</strong><small>{{ block.settings.text }}</small></div></div>{% endfor %}</div></section>
{% schema %}{"name":"Benefits","max_blocks":6,"blocks":[{"type":"benefit","name":"Benefit","settings":[{"type":"text","id":"icon","label":"Icon","default":"🚚"},{"type":"text","id":"title","label":"Title","default":"Free Shipping"},{"type":"text","id":"text","label":"Text","default":"On orders above ₹499"}]}],"presets":[{"name":"Benefits","blocks":[{"type":"benefit","settings":{"icon":"🚚","title":"Free Shipping","text":"On orders above ₹499"}},{"type":"benefit","settings":{"icon":"🛡","title":"Secure Payments","text":"100% safe & secure"}},{"type":"benefit","settings":{"icon":"↩","title":"Easy Returns","text":"Hassle-free returns"}},{"type":"benefit","settings":{"icon":"♡","title":"Quality Products","text":"Curated with care"}},{"type":"benefit","settings":{"icon":"◔","title":"24/7 Support","text":"We're here to help"}}]}]}{% endschema %}