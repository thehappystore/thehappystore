<section class="page-width section-space">
  <div class="category-grid">
    {% for block in section.blocks %}
      <a class="category-card" href="{{ block.settings.link }}" style="--card-bg:{{ block.settings.background }}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1000 | image_tag: loading:'lazy', alt:block.settings.title | escape }}{% else %}{% assign demo_cat = 'cat-' | append: forloop.index | append: '.jpg' %}{% if forloop.index == 1 %}{{ 'cat-men.jpg' | asset_url | image_tag: loading:'lazy', alt:block.settings.title | escape }}{% elsif forloop.index == 2 %}{{ 'cat-women.jpg' | asset_url | image_tag: loading:'lazy', alt:block.settings.title | escape }}{% else %}{{ 'cat-toys.jpg' | asset_url | image_tag: loading:'lazy', alt:block.settings.title | escape }}{% endif %}{% endif %}
        <div class="category-copy"><h3>{{ block.settings.title }}</h3><p>{{ block.settings.subtitle }}</p><span>{{ block.settings.button }} →</span></div>
      </a>
    {% endfor %}
  </div>
</section>
{% schema %}
{"name":"Category cards","max_blocks":6,"blocks":[{"type":"category","name":"Category","settings":[
{"type":"text","id":"title","label":"Title","default":"Men's Fashion"},{"type":"text","id":"subtitle","label":"Subtitle","default":"Style for Every Occasion"},
{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"link","label":"Link"},{"type":"text","id":"button","label":"Button","default":"Shop Now"},
{"type":"color","id":"background","label":"Background","default":"#dbeeff"}]}],
"presets":[{"name":"Category cards","blocks":[{"type":"category"},{"type":"category","settings":{"title":"Women's Fashion","subtitle":"Trendy Looks You'll Love","background":"#ffe0ec"}},{"type":"category","settings":{"title":"Toys & Gadgets","subtitle":"Fun. Smart. Exciting.","background":"#ffe98f"}}]}]}
{% endschema %}