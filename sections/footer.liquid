<footer class="site-footer"><div class="page-width footer-grid">
  <div class="footer-brand"><a class="brand" href="{{ routes.root_url }}">{% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 300 | image_tag: class:'brand-logo', alt:shop.name }}{% else %}<span class="brand-the">The</span><span class="brand-happy">Happy</span><span class="brand-store">Store</span>{% endif %}</a><p>{{ section.settings.tagline }}</p><p>{{ section.settings.description }}</p></div>
  <div><h4>{{ section.settings.shop_title }}</h4>{% for link in section.settings.shop_menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}</div>
  <div><h4>{{ section.settings.care_title }}</h4>{% for link in section.settings.care_menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}</div>
  <div><h4>{{ section.settings.about_title }}</h4>{% for link in section.settings.about_menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}</div>
  <div><h4>{{ section.settings.social_title }}</h4><div class="socials">{% if section.settings.instagram != blank %}<a href="{{ section.settings.instagram }}" target="_blank">Instagram</a>{% endif %}{% if section.settings.facebook != blank %}<a href="{{ section.settings.facebook }}" target="_blank">Facebook</a>{% endif %}{% if section.settings.youtube != blank %}<a href="{{ section.settings.youtube }}" target="_blank">YouTube</a>{% endif %}</div></div>
</div><div class="page-width footer-bottom"><span>© {{ 'now' | date:'%Y' }} {{ shop.name }}</span><span>{{ section.settings.bottom_text }}</span></div></footer>
{% schema %}{"name":"Footer","settings":[{"type":"image_picker","id":"logo","label":"Footer logo"},{"type":"text","id":"tagline","label":"Tagline","default":"Fashion. Toys. Gadgets. And More."},{"type":"textarea","id":"description","label":"Description","default":"Happiness Delivered."},{"type":"text","id":"shop_title","label":"Shop title","default":"Shop"},{"type":"link_list","id":"shop_menu","label":"Shop menu","default":"footer"},{"type":"text","id":"care_title","label":"Care title","default":"Customer Care"},{"type":"link_list","id":"care_menu","label":"Care menu","default":"footer"},{"type":"text","id":"about_title","label":"About title","default":"About"},{"type":"link_list","id":"about_menu","label":"About menu","default":"footer"},{"type":"text","id":"social_title","label":"Social title","default":"Follow Us"},{"type":"url","id":"instagram","label":"Instagram"},{"type":"url","id":"facebook","label":"Facebook"},{"type":"url","id":"youtube","label":"YouTube"},{"type":"text","id":"bottom_text","label":"Bottom text","default":"Secure shopping • Easy returns • Fast delivery"}],"presets":[{"name":"Footer"}]}{% endschema %}