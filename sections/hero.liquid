<section class="hero page-width">
  <div class="hero-slider" data-slider>
    {% for block in section.blocks %}
      <article class="hero-slide {% if forloop.first %}is-active{% endif %}" data-slide {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 2200 | image_tag: loading: 'eager', class: 'hero-image', alt: block.settings.heading | escape }}
        {% else %}
          {{ 'hero.jpg' | asset_url | image_tag: loading: 'eager', class: 'hero-image', alt: block.settings.heading | escape }}
        {% endif %}
        <div class="hero-overlay" style="--hero-width:{{ block.settings.text_width }}%;">
          <h1>{{ block.settings.heading }}</h1>
          <p>{{ block.settings.subheading }}</p>
          {% if block.settings.button_label != blank %}<a class="btn btn-dark" href="{{ block.settings.button_link }}">{{ block.settings.button_label }} →</a>{% endif %}
        </div>
      </article>
    {% endfor %}
    {% if section.blocks.size > 1 %}
      <button class="slider-arrow prev" data-prev aria-label="Previous">‹</button><button class="slider-arrow next" data-next aria-label="Next">›</button>
      <div class="slider-dots">{% for block in section.blocks %}<button class="{% if forloop.first %}active{% endif %}" data-dot="{{ forloop.index0 }}"></button>{% endfor %}</div>
    {% endif %}
  </div>
</section>
{% schema %}
{"name":"Hero banner","max_blocks":6,"blocks":[
{"type":"slide","name":"Slide","settings":[
{"type":"image_picker","id":"image","label":"Banner image"},
{"type":"text","id":"heading","label":"Heading","default":"Everything You Love One Happy Store."},
{"type":"text","id":"subheading","label":"Subheading","default":"Fashion. Toys. Gadgets. And More."},
{"type":"text","id":"button_label","label":"Button label","default":"Shop Now"},
{"type":"url","id":"button_link","label":"Button link"},
{"type":"range","id":"text_width","label":"Text width","min":25,"max":65,"step":5,"unit":"%","default":40}
]}],"presets":[{"name":"Hero banner","blocks":[{"type":"slide"},{"type":"slide"}]}]}
{% endschema %}