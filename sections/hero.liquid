<section class="page-width hero-section"><div class="hero-slider" data-slider>
{% for block in section.blocks %}<article class="hero-slide {% if forloop.first %}is-active{% endif %}" data-slide {{ block.shopify_attributes }} style="--hero-align:{{ block.settings.content_alignment }};--hero-width:{{ block.settings.text_width }}%;">
{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 2400 | image_tag: class:'hero-image', loading:'eager', alt:block.settings.heading | escape }}{% else %}<img class="hero-image" src="{{ 'demo-home-hero.jpg' | asset_url }}" alt="The Happy Store" loading="eager">{% endif %}
<div class="hero-overlay"><h1>{{ block.settings.heading }}</h1><p>{{ block.settings.subheading }}</p>{% if block.settings.show_benefits %}<div class="hero-mini-benefits"><span>🚚 {{ block.settings.benefit1 }}</span><span>🛡 {{ block.settings.benefit2 }}</span><span>↩ {{ block.settings.benefit3 }}</span><span>♡ {{ block.settings.benefit4 }}</span></div>{% endif %}{% if block.settings.button_label != blank %}<a class="btn btn-dark" href="{{ block.settings.button_link }}">{{ block.settings.button_label }} →</a>{% endif %}</div></article>{% endfor %}
{% if section.blocks.size > 1 %}<button class="slider-arrow prev" data-prev>‹</button><button class="slider-arrow next" data-next>›</button><div class="slider-dots">{% for block in section.blocks %}<button data-dot="{{ forloop.index0 }}" class="{% if forloop.first %}active{% endif %}"></button>{% endfor %}</div>{% endif %}</div></section>
{% schema %}{"name":"Hero banner","max_blocks":6,"blocks":[{"type":"slide","name":"Slide","settings":[{"type":"image_picker","id":"image","label":"Hero image"},{"type":"text","id":"heading","label":"Heading","default":"Everything You Love One Happy Store."},{"type":"text","id":"subheading","label":"Subheading","default":"Fashion. Toys. Gadgets. And More."},{"type":"text","id":"button_label","label":"Button label","default":"Shop Now"},{"type":"url","id":"button_link","label":"Button link"},{"type":"checkbox","id":"show_benefits","label":"Show mini benefits","default":true},{"type":"text","id":"benefit1","label":"Benefit 1","default":"Fast Shipping"},{"type":"text","id":"benefit2","label":"Benefit 2","default":"Easy Payments"},{"type":"text","id":"benefit3","label":"Benefit 3","default":"Easy Returns"},{"type":"text","id":"benefit4","label":"Benefit 4","default":"Happy Customers"},{"type":"range","id":"text_width","label":"Text width","min":30,"max":65,"step":5,"unit":"%","default":40},{"type":"select","id":"content_alignment","label":"Content alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}],"default":"left"}]}],"presets":[{"name":"Hero banner","blocks":[{"type":"slide"},{"type":"slide"}]}]}{% endschema %}