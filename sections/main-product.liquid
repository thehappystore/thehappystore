<section class="page-width product-page"><div class="breadcrumbs"><a href="{{ routes.root_url }}">Home</a> / {% if product.collections.first %}<a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a> / {% endif %}{{ product.title }}</div><div class="product-layout"><div class="product-gallery"><div class="thumbs">{% for image in product.images %}<button type="button" data-gallery-thumb="{{ forloop.index0 }}">{{ image | image_url: width:180 | image_tag: loading:'lazy', alt:product.title }}</button>{% endfor %}</div><div class="main-product-image">{% if product.featured_image %}{{ product.featured_image | image_url: width:1300 | image_tag: loading:'eager', id:'ProductMainImage', alt:product.title }}{% else %}<img id="ProductMainImage" src="{{ 'demo-headphones-main.jpg' | asset_url }}" alt="{{ product.title }}">{% endif %}<span class="media-count">{{ product.images.size }} photos</span></div></div><div class="product-details"><p class="vendor">{{ product.vendor }}</p><h1>{{ product.title }}</h1><div class="rating large"><span class="rating-stars">★★★★★</span> <b>{{ section.settings.rating }}</b> <span>({{ section.settings.review_count }} reviews)</span></div><div class="lead">{{ section.settings.short_description | default: product.description | strip_html | truncate: 260 }}</div><div class="product-price"><strong>{{ product.price | money }}</strong>{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s><span class="discount-pill">{{ product.compare_at_price | minus:product.price | times:100 | divided_by:product.compare_at_price | round }}% OFF</span>{% endif %}</div><script type="application/json" id="ProductJson-{{ section.id }}">{{ product | json }}</script>{% form 'product', product, id:'product-form', class:'product-form' %}{% unless product.has_only_default_variant %}{% for option in product.options_with_values %}<fieldset class="variant-fieldset"><legend>{{ option.name }}</legend><div class="option-values">{% for value in option.values %}<label><input type="radio" name="options[{{ option.name }}]" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}><span>{{ value }}</span></label>{% endfor %}</div></fieldset>{% endfor %}{% endunless %}<div class="stock-line">{% if product.available %}<span>●</span> {{ section.settings.in_stock_text }}{% else %}<span class="out">●</span> {{ section.settings.sold_out_text }}{% endif %}</div><div class="quantity-row"><label>{{ section.settings.quantity_label }}</label><button type="button" data-qty-minus>−</button><input type="number" name="quantity" value="1" min="1" id="Quantity"><button type="button" data-qty-plus>+</button></div><input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><div class="product-actions"><button class="btn btn-primary" type="submit" {% unless product.available %}disabled{% endunless %}>🛒 {{ section.settings.add_label }}</button><button class="btn btn-outline" type="button" data-buy-now {% unless product.available %}disabled{% endunless %}>⚡ {{ section.settings.buy_label }}</button></div>{% endform %}<div class="trust-row">{% for block in section.blocks %}{% if block.type == 'trust' %}<div {{ block.shopify_attributes }}><b>{{ block.settings.icon }}</b><span><strong>{{ block.settings.title }}</strong><small>{{ block.settings.text }}</small></span></div>{% elsif block.type == '@app' %}{% render block %}{% endif %}{% endfor %}</div><div class="delivery-box">🚚 <strong>{{ section.settings.delivery_title }}</strong><span>{{ section.settings.delivery_text }}</span></div></div></div>{% if section.settings.show_feature_banner %}<div class="product-feature-banner">{% if section.settings.feature_image != blank %}{{ section.settings.feature_image | image_url: width:1500 | image_tag: loading:'lazy', alt:section.settings.feature_heading }}{% else %}<img src="{{ 'demo-headphones-banner.jpg' | asset_url }}" alt="{{ section.settings.feature_heading }}">{% endif %}<div><h2>{{ section.settings.feature_heading }}</h2><p>{{ section.settings.feature_text }}</p></div></div>{% endif %}<div class="product-tabs"><div class="tab-head">{% for block in section.blocks %}{% if block.type == 'tab' %}<button data-tab="tab-{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.title }}</button>{% endif %}{% endfor %}</div>{% for block in section.blocks %}{% if block.type == 'tab' %}<div class="tab-panel" id="tab-{{ block.id }}"><div class="rte">{{ block.settings.content }}</div></div>{% endif %}{% endfor %}</div></section>
{% schema %}{"name":"Product page","blocks":[{"type":"trust","name":"Trust item","settings":[{"type":"text","id":"icon","label":"Icon","default":"🛡"},{"type":"text","id":"title","label":"Title","default":"Secure Payments"},{"type":"text","id":"text","label":"Text","default":"100% safe & secure"}]},{"type":"tab","name":"Product tab","settings":[{"type":"text","id":"title","label":"Tab title","default":"Product Description"},{"type":"richtext","id":"content","label":"Content","default":"<p>Add your product information here.</p>"}]},{"type":"@app"}],"settings":[{"type":"text","id":"rating","label":"Rating display","default":"4.4"},{"type":"text","id":"review_count","label":"Review count display","default":"2,348"},{"type":"textarea","id":"short_description","label":"Short description","default":"Experience powerful sound, deep bass, and all-day comfort. Perfect for music, movies, gaming, and calls."},{"type":"text","id":"in_stock_text","label":"In-stock text","default":"In Stock"},{"type":"text","id":"sold_out_text","label":"Sold-out text","default":"Sold Out"},{"type":"text","id":"quantity_label","label":"Quantity label","default":"Quantity"},{"type":"text","id":"add_label","label":"Add to cart text","default":"Add to Cart"},{"type":"text","id":"buy_label","label":"Buy now text","default":"Buy Now"},{"type":"text","id":"delivery_title","label":"Delivery title","default":"Fast Delivery"},{"type":"text","id":"delivery_text","label":"Delivery text","default":" Ships quickly to your address."},{"type":"checkbox","id":"show_feature_banner","label":"Show feature banner","default":true},{"type":"image_picker","id":"feature_image","label":"Feature banner image"},{"type":"text","id":"feature_heading","label":"Feature heading","default":"Feel the Music. Live the Moment."},{"type":"text","id":"feature_text","label":"Feature text","default":"Deep Bass. All-Day Comfort. Made for Every Vibe."}],"presets":[{"name":"Product page","blocks":[{"type":"trust","settings":{"icon":"🛡","title":"Secure Payments","text":"100% safe & secure"}},{"type":"trust","settings":{"icon":"↩","title":"Easy Returns","text":"7-day hassle-free"}},{"type":"trust","settings":{"icon":"🚚","title":"Free Shipping","text":"On orders above ₹499"}},{"type":"tab","settings":{"title":"Product Description","content":"<p>Add your product description from Shopify.</p>"}},{"type":"tab","settings":{"title":"Specifications","content":"<p>Add specifications here.</p>"}},{"type":"tab","settings":{"title":"Shipping & Returns","content":"<p>Add shipping and returns information here.</p>"}},{"type":"tab","settings":{"title":"Reviews","content":"<p>Connect your reviews app or add review content.</p>"}},{"type":"tab","settings":{"title":"FAQs","content":"<p>Add frequently asked questions here.</p>"}}]}]}{% endschema %}