<section class="page-width search-page"><h1>{{ section.settings.heading }}</h1><form action="{{ routes.search_url }}" method="get" class="search-large"><input name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.placeholder }}"><button>{{ section.settings.button }}</button></form>{% if search.performed %}<p>{{ search.results_count }} results for “{{ search.terms }}”</p><div class="product-grid">{% paginate search.results by 24 %}{% for result in search.results %}{% if result.object_type == 'product' %}{% render 'product-card', product:result %}{% endif %}{% endfor %}{{ paginate | default_pagination }}{% endpaginate %}</div>{% endif %}</section>
{% schema %}{"name":"Search","settings":[{"type":"text","id":"heading","label":"Heading","default":"Search"},{"type":"text","id":"placeholder","label":"Placeholder","default":"Search products..."},{"type":"text","id":"button","label":"Button","default":"Search"}],"presets":[{"name":"Search"}]}{% endschema %}