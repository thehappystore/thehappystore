<section class="page-width newsletter"><div class="newsletter-inner"><div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div>{% form 'customer', class:'newsletter-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><input type="email" name="contact[email]" placeholder="{{ section.settings.placeholder }}" required><button type="submit">{{ section.settings.button }}</button>{% endform %}</div></section>
{% schema %}{"name":"Newsletter","settings":[{"type":"image_picker","id":"background_image","label":"Background image"},{"type":"text","id":"heading","label":"Heading","default":"Join The Happy Store Community"},{"type":"text","id":"text","label":"Text","default":"Get exclusive offers, new arrivals and happy updates."},{"type":"text","id":"placeholder","label":"Placeholder","default":"Enter your email address"},{"type":"text","id":"button","label":"Button","default":"Subscribe"}],"presets":[{"name":"Newsletter"}]}{% endschema %}