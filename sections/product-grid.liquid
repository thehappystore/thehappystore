<section class="page-width section-space"><div class="section-heading"><div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.subheading }}</p></div>{% if section.settings.collection != blank %}<a href="{{ section.settings.collection.url }}">{{ section.settings.view_all_text }} →</a>{% endif %}</div>{% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}<div class="product-grid">{% for product in section.settings.collection.products limit:section.settings.limit %}{% render 'product-card', product:product %}{% endfor %}</div>{% else %}<div class="editor-empty"><strong>{{ section.settings.empty_title }}</strong><span>{{ section.settings.empty_text }}</span></div>{% endif %}</section>
{% schema %}{"name":"Product grid","settings":[{"type":"text","id":"heading","label":"Heading","default":"Trending Now 🔥"},{"type":"text","id":"subheading","label":"Subheading","default":"Discover what everyone’s loving right now"},{"type":"collection","id":"collection","label":"Product collection"},{"type":"range","id":"limit","label":"Number of products","min":2,"max":12,"step":1,"default":6},{"type":"text","id":"view_all_text","label":"View all text","default":"View All"},{"type":"text","id":"empty_title","label":"Empty title","default":"Select a collection"},{"type":"text","id":"empty_text","label":"Empty text","default":"Choose a collection in the Theme Editor to display your Shopify products here."}],"presets":[{"name":"Product grid"}]}{% endschema %}