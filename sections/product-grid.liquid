<section class="page-width section-space" id="product-grid-{{ section.id }}">

  <div class="section-heading">

    <div>
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p>{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    {% if section.settings.collection != blank %}
      <a href="{{ section.settings.collection.url }}">
        {{ section.settings.view_all_text }} →
      </a>
    {% endif %}

  </div>


  {% if section.settings.collection != blank %}

    {% assign selected_collection = section.settings.collection %}

    {% if selected_collection.products_count > 0 %}

      <div class="product-grid">

        {% for product in selected_collection.products limit: section.settings.limit %}

          <article class="product-card">

            <!-- PRODUCT IMAGE -->
            <a
              href="{{ product.url }}"
              class="product-media"
              aria-label="{{ product.title | escape }}"
            >

              {% if product.compare_at_price > product.price %}

                {% assign discount_amount = product.compare_at_price
                  | minus: product.price %}

                {% assign discount_percentage = discount_amount
                  | times: 100
                  | divided_by: product.compare_at_price
                  | round %}

                <span class="discount">
                  {{ discount_percentage }}% OFF
                </span>

              {% endif %}


              {% if product.featured_image %}

                {{
                  product.featured_image
                  | image_url: width: 700
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 400, 500, 600, 700',
                    sizes: '(min-width: 1200px) 16vw, (min-width: 750px) 25vw, 50vw',
                    alt: product.title
                }}

              {% else %}

                <div class="image-placeholder">
                  <span>No Image</span>
                </div>

              {% endif %}


              <!-- WISHLIST -->
              <button
                type="button"
                class="wishlist"
                aria-label="Add {{ product.title | escape }} to wishlist"
                data-wishlist
              >
                ♡
              </button>

            </a>


            <!-- PRODUCT INFORMATION -->
            <div class="product-info">

              <a href="{{ product.url }}">

                <h3>
                  {{ product.title }}
                </h3>

              </a>


              {% if product.vendor != blank %}

                <small class="product-vendor">
                  {{ product.vendor }}
                </small>

              {% endif %}


              <!-- RATING -->
              <div class="rating">

                <span class="rating-stars">
                  ★★★★★
                </span>

                {% assign rating_count = product.metafields.reviews.rating_count %}

                {% if rating_count != blank %}
                  <span>
                    ({{ rating_count }})
                  </span>
                {% endif %}

              </div>


              <!-- PRICE -->
              <div class="price">

                <strong>
                  {{ product.price | money }}
                </strong>


                {% if product.compare_at_price > product.price %}

                  <s>
                    {{ product.compare_at_price | money }}
                  </s>

                {% endif %}

              </div>


              <!-- AVAILABILITY / QUICK ADD -->
              {% if product.available %}

                <button
                  type="button"
                  class="quick-add"
                  data-quick-add
                  data-variant="{{ product.selected_or_first_available_variant.id }}"
                >
                  Add to Cart
                </button>

              {% else %}

                <span class="sold-out">
                  Sold Out
                </span>

              {% endif %}

            </div>

          </article>

        {% endfor %}

      </div>


    {% else %}

      <!-- COLLECTION EXISTS BUT HAS NO PRODUCTS -->

      <div class="product-grid-empty">

        <div class="empty-products-message">

          <h3>
            No products available yet
          </h3>

          <p>
            Add products to this collection from Shopify Admin.
          </p>

        </div>

      </div>

    {% endif %}


  {% else %}

    <!-- NO COLLECTION SELECTED -->

    <div class="product-grid-empty">

      <div class="empty-products-message">

        <h3>
          Select a collection
        </h3>

        <p>
          Choose a Shopify collection from the Theme Editor to display products here.
        </p>

      </div>

    </div>

  {% endif %}


</section>


<style>

  #product-grid-{{ section.id }} .product-grid-empty {
    width: 100%;
    min-height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f7f8fa;
    border-radius: 14px;
    text-align: center;
    padding: 40px 20px;
  }

  #product-grid-{{ section.id }} .empty-products-message h3 {
    margin: 0 0 8px;
    font-size: 20px;
  }

  #product-grid-{{ section.id }} .empty-products-message p {
    margin: 0;
    color: #777;
  }

  #product-grid-{{ section.id }} .product-media {
    display: block;
    position: relative;
    overflow: hidden;
  }

  #product-grid-{{ section.id }} .product-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #product-grid-{{ section.id }} .image-placeholder {
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #f1f2f4;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #888;
  }

  #product-grid-{{ section.id }} .product-vendor {
    display: block;
    color: #777;
    margin: 3px 0;
  }

  #product-grid-{{ section.id }} .rating {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  #product-grid-{{ section.id }} .rating-stars {
    color: #ffb000;
    letter-spacing: 1px;
  }

</style>


{% schema %}

{
  "name": "Product grid",

  "tag": "section",

  "class": "shopify-section-product-grid",

  "settings": [

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trending Now 🔥"
    },

    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover what everyone’s loving right now"
    },

    {
      "type": "collection",
      "id": "collection",
      "label": "Product collection"
    },

    {
      "type": "range",
      "id": "limit",
      "label": "Number of products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },

    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all text",
      "default": "View All"
    }

  ],

  "presets": [

    {
      "name": "Product grid"
    }

  ]

}

{% endschema %}
