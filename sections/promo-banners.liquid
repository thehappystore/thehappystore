<section class="page-width section-space">
  <div class="promo-grid">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link }}" class="promo-card" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1400 | image_tag: loading:'lazy', alt:block.settings.heading | escape }}{% else %}{% if forloop.index == 1 %}{{ 'promo-men.jpg' | asset_url | image_tag: loading:'lazy', alt:block.settings.heading | escape }}{% elsif forloop.index == 2 %}{{ 'promo-women.jpg' | asset_url | image_tag: loading:'lazy', alt:block.settings.heading | escape }}{% else %}{{ 'promo-toys.jpg' | asset_url | image_tag: loading:'lazy', alt:block.settings.heading | escape }}{% endif %}{% endif %}
        <div><h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p><span class="btn btn-dark">{{ block.settings.button }} →</span></div>
      </a>
    {% endfor %}
  </div>
</section>
{% schema %}
{"name":"Promo banners","max_blocks":3,"blocks":[{"type":"banner","name":"Banner","settings":[
{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"heading","label":"Heading","default":"Upgrade Your Style"},
{"type":"text","id":"text","label":"Text","default":"Explore the latest collection"},{"type":"text","id":"button","label":"Button","default":"Shop Now"},{"type":"url","id":"link","label":"Link"}]}],
"presets":[{"name":"Promo banners","blocks":[{"type":"banner"},{"type":"banner","settings":{"heading":"Trendy Looks For Every You","text":"Women's Fashion Collection"}},{"type":"banner","settings":{"heading":"Fun Gadgets Happier Days","text":"Explore Toys & Gadgets"}}]}]}
{% endschema %}