<section class="page-width section-space"><div class="promo-grid">{% for block in section.blocks %}<a class="promo-card" href="{{ block.settings.link }}" {{ block.shopify_attributes }} style="--promo-bg:{{ block.settings.background }}">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width:1400 | image_tag: loading:'lazy', alt:block.settings.heading | escape }}{% elsif block.settings.demo_asset != blank %}<img src="{{ block.settings.demo_asset | asset_url }}" alt="{{ block.settings.heading | escape }}" loading="lazy">{% endif %}<div><h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p>{% if block.settings.button != blank %}<span class="btn btn-dark">{{ block.settings.button }} →</span>{% endif %}</div></a>{% endfor %}</div></section>
{% schema %}{"name":"Promo banners","max_blocks":3,"blocks":[{"type":"banner","name":"Banner","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"demo_asset","label":"Demo asset filename","default":"demo-promo-men.jpg"},{"type":"text","id":"heading","label":"Heading","default":"Upgrade Your Style"},{"type":"text","id":"text","label":"Text","default":"Explore the latest collection"},{"type":"text","id":"button","label":"Button","default":"Shop Now"},{"type":"url","id":"link","label":"Link"},{"type":"color","id":"background","label":"Background","default":"#efe2d2"}]}],"presets":[{"name":"Promo banners","blocks":[{"type":"banner","settings":{"demo_asset":"demo-promo-men.jpg"}},{"type":"banner","settings":{"demo_asset":"demo-promo-women.jpg","heading":"Trendy Looks For Every You","text":"Women's Fashion Collection"}},{"type":"banner","settings":{"demo_asset":"demo-promo-toys.jpg","heading":"Fun Gadgets Happier Days","text":"Explore Toys & Gadgets"}}]}]}{% endschema %}