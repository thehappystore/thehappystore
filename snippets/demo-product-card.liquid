<article class="product-card">

  <a href="{{ product.url }}" class="product-media">

    {% if product.compare_at_price > product.price %}
      <span class="discount">
        {{ product.compare_at_price
          | minus: product.price
          | times: 100
          | divided_by: product.compare_at_price
          | round }}% OFF
      </span>
    {% endif %}

    {% if product.featured_image %}
      {{
        product.featured_image
        | image_url: width: 700
        | image_tag:
          loading: 'lazy',
          widths: '360, 540, 700',
          sizes: '(min-width: 1100px) 16vw, (min-width: 750px) 25vw, 50vw',
          alt: product.title
      }}
    {% else %}
      <div class="image-placeholder">
        No image available
      </div>
    {% endif %}

    <button
      class="wishlist"
      type="button"
      aria-label="Add {{ product.title }} to wishlist"
      data-wishlist>
      ♡
    </button>

  </a>

  <div class="product-info">

    <a href="{{ product.url }}">
      <h3>{{ product.title }}</h3>
    </a>

    {% if product.vendor != blank %}
      <small class="product-vendor">
        {{ product.vendor }}
      </small>
    {% endif %}

    <div class="rating">
      ★★★★★
      <span>
        {% if product.metafields.reviews.rating_count != blank %}
          ({{ product.metafields.reviews.rating_count }})
        {% endif %}
      </span>
    </div>

    <div class="price">
      <strong>{{ product.price | money }}</strong>

      {% if product.compare_at_price > product.price %}
        <s>{{ product.compare_at_price | money }}</s>
      {% endif %}
    </div>

    {% if product.available %}

      <button
        class="quick-add"
        type="button"
        data-quick-add
        data-variant="{{ product.selected_or_first_available_variant.id }}">
        Add to Cart
      </button>

    {% else %}

      <span class="sold-out">
        Sold Out
      </span>

    {% endif %}

  </div>

</article>
