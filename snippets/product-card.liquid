<article class="product-card" {{ card_attributes }}><a href="{{ product.url }}" class="product-media">{% if product.compare_at_price > product.price %}<span class="discount">{{ product.compare_at_price | minus:product.price | times:100 | divided_by:product.compare_at_price | round }}% OFF</span>{% endif %}{% if product.featured_image %}{{ product.featured_image | image_url: width:700 | image_tag: loading:'lazy', widths:'300,400,500,600,700', sizes:'(min-width:1200px) 16vw, (min-width:750px) 25vw, 50vw', alt:product.title }}{% else %}<div class="image-placeholder">No image</div>{% endif %}<button class="wishlist" type="button" data-wishlist aria-label="Add to wishlist">♡</button></a><div class="product-info"><a href="{{ product.url }}"><h3>{{ product.title }}</h3></a>{% if product.vendor != blank %}<small class="product-vendor">{{ product.vendor }}</small>{% endif %}<div class="rating"><span class="rating-stars">★★★★★</span>{% assign rc=product.metafields.reviews.rating_count %}{% if rc != blank %}<span>({{ rc }})</span>{% endif %}</div><div class="price"><strong>{{ product.price | money }}</strong>{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</div>{% if product.available %}<button class="quick-add" type="button" data-quick-add data-variant="{{ product.selected_or_first_available_variant.id }}">Add to Cart</button>{% else %}<span class="sold-out">Sold Out</span>{% endif %}</div></article>