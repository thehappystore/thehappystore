<section class="page-width auth-page"><h1>Account Login</h1>{% form 'customer_login' %}{{ form.errors | default_errors }}<input type="email" name="customer[email]" placeholder="Email" required><input type="password" name="customer[password]" placeholder="Password" required><button class="btn btn-primary">Sign In</button><a href="{{ routes.account_register_url }}">Create account</a>{% endform %}</section>