<section class="page-width auth-page"><h1>Create Account</h1>{% form 'create_customer' %}{{ form.errors | default_errors }}<input name="customer[first_name]" placeholder="First name"><input name="customer[last_name]" placeholder="Last name"><input type="email" name="customer[email]" placeholder="Email" required><input type="password" name="customer[password]" placeholder="Password" required><button class="btn btn-primary">Create Account</button>{% endform %}</section>